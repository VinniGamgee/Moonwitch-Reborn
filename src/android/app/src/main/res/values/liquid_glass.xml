<resources>
<string name="mw_liquid_glass">Liquid Glass</string>
<string name="mw_liquid_glass_description">Vidro translúcido, desfoque do fundo e reflexos em toda a interface. Pode aumentar o consumo de energia.</string>
<style name="Theme.Moonwitch.Glass" parent="Theme.Moonwitch.Main">
<item name="android:windowBackground">@drawable/mw_glass_canvas</item>
<item name="colorSurface">#18263D</item><item name="colorSurfaceContainer">#24354D</item>
<item name="materialAlertDialogTheme">@style/ThemeOverlay.Moonwitch.Glass.Dialog</item>
<item name="bottomSheetDialogTheme">@style/Theme.Moonwitch.Glass.Sheet</item>
<item name="colorPrimary">#9FF3DF</item><item name="colorOutline">#779AAE</item>
</style>
<style name="ThemeOverlay.Moonwitch.Glass.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
<item name="colorSurface">#DC203247</item><item name="colorOnSurface">#F0FBFF</item>
<item name="colorPrimary">#9FF3DF</item><item name="android:windowBackgroundBlurRadius">32dp</item>
<item name="android:windowIsTranslucent">true</item>
</style>
<style name="Theme.Moonwitch.Glass.Sheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
<item name="colorSurface">#DC203247</item><item name="colorOnSurface">#F0FBFF</item>
<item name="colorPrimary">#9FF3DF</item><item name="android:windowBackgroundBlurRadius">32dp</item>
<item name="android:windowIsTranslucent">true</item>
</style></resources>