<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_ui_bg"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/brand_mark"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/moonwitch_app_icon" />

        <LinearLayout
            android:id="@+id/brand_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/mw_ui_text"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mw_ui_switch_emulator"
                android:textColor="@color/mw_ui_text_3"
                android:textSize="8sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/view_button"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/filter_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_filter"
                app:tint="@color/mw_ui_text_2" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mw_ui_settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/mw_ui_text" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/library_tabs_scroll"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_tab_all"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:text="@string/mw_ui_all"
                android:textAllCaps="false"
                android:textColor="@color/mw_ui_text"
                android:textSize="12sp"
                app:backgroundTint="@color/mw_ui_surface_2"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_tab_recent"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="7dp"
                android:minWidth="0dp"
                android:text="@string/mw_ui_recent"
                android:textAllCaps="false"
                android:textColor="@color/mw_ui_text"
                android:textSize="12sp"
                app:backgroundTint="@color/mw_ui_surface_2"
                app:cornerRadius="17dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_tab_favorites"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="7dp"
                android:minWidth="0dp"
                android:text="@string/mw_ui_favorites"
                android:textAllCaps="false"
                android:textColor="@color/mw_ui_text"
                android:textSize="12sp"
                app:backgroundTint="@color/mw_ui_surface_2"
                app:cornerRadius="17dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/library_hero"
        android:layout_width="0dp"
        android:layout_height="184dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/mw_reformulation_item_selector"
        android:clipToOutline="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_tabs_scroll">

        <ImageView
            android:id="@+id/library_hero_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.62"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/default_icon" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mw_home_frontend_hero_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/library_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/mw_ui_text"
                android:textSize="20sp"
                tools:text="The Legend of Zelda: Breath of the Wild" />

            <TextView
                android:id="@+id/library_hero_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mw_ui_text_2"
                android:textSize="10sp"
                tools:text="Nintendo • 1.6.0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/library_hero_play"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/mw_ui_play"
                    android:textAllCaps="false"
                    android:textColor="@color/mw_ui_text"
                    android:textSize="11sp"
                    app:backgroundTint="@color/mw_ui_accent"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_play"
                    app:iconSize="15dp"
                    app:iconTint="@color/mw_ui_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/library_hero_open"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text=""
                    app:backgroundTint="@color/mw_ui_surface_2"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_more_vert"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/mw_ui_text"
                    app:strokeColor="@color/mw_ui_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frame_search"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_hero">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="9dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/mw_ui_text_3" />

                <EditText
                    android:id="@+id/search_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/home_search_games"
                    android:imeOptions="flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/mw_ui_text"
                    android:textColorHint="@color/mw_ui_text_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/clear_button"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="13dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_clear"
                android:visibility="invisible"
                app:tint="@color/mw_ui_text_2" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <TextView
        android:id="@+id/library_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="11dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/mw_ui_games"
        android:textColor="@color/mw_ui_text"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frame_search" />

    <org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_section_label">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/empty_gamelist"
                android:textColor="@color/mw_ui_text_2"
                android:textSize="13sp"
                android:visibility="gone" />

            <org.yuzu.yuzu_emu.ui.CarouselRecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="18dp"
                android:scrollbars="none" />
        </RelativeLayout>
    </org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/mw_ui_surface"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/mw_ui_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <LinearLayout
                android:id="@+id/bottom_library"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/mw_ui_library"
                    android:src="@drawable/ic_cartridge"
                    app:tint="@color/mw_ui_accent_hi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mw_ui_library"
                    android:textColor="@color/mw_ui_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottom_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/mw_ui_settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/mw_ui_text_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/mw_ui_settings"
                    android:textColor="@color/mw_ui_text_2"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/add_directory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="@string/moonwitch_manage_library"
        app:backgroundTint="@color/mw_ui_accent"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/mw_ui_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="20dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/launch_qlaunch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginBottom="84dp"
        android:contentDescription="@string/moonwitch_system_menu"
        app:backgroundTint="@color/mw_ui_surface_2"
        app:icon="@drawable/moonwitch_app_icon"
        app:iconTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:maxImageSize="28dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

</androidx.constraintlayout.widget.ConstraintLayout>
