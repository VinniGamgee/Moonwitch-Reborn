<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/mw_reform_bg"><LinearLayout android:id="@+id/library_header" android:layout_width="match_parent" android:layout_height="56dp" android:paddingStart="16dp" android:paddingEnd="4dp" android:gravity="center_vertical">
<ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_moonwitch_mark" android:contentDescription="@string/app_name"/>
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Moonwitch" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/mw_reform_text"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/search_button" style="@style/Widget.Moonwitch.Reform.Icon" android:src="@drawable/ic_search" android:contentDescription="@string/mw_reform_search"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/filter_button" style="@style/Widget.Moonwitch.Reform.Icon" android:src="@drawable/ic_more_vert" android:contentDescription="@string/mw_filters"/>
</LinearLayout><EditText android:id="@+id/search_text" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp" android:visibility="gone" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:hint="@string/mw_reform_search" android:textSize="16sp" android:textColor="@color/mw_reform_text" android:textColorHint="@color/mw_reform_muted"/><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<androidx.viewpager2.widget.ViewPager2 android:id="@+id/game_pager" android:layout_width="match_parent" android:layout_height="match_parent"/>
<LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:visibility="gone">
<ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_moonwitch_mark" android:importantForAccessibility="no"/>
<TextView android:id="@+id/empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="@string/mw_reform_empty" android:textSize="22sp" android:textColor="@color/mw_reform_text"/>
<TextView android:id="@+id/empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/mw_reform_empty_hint" android:textColor="@color/mw_reform_muted"/>
<com.google.android.material.button.MaterialButton android:id="@+id/add_directory" style="@style/Widget.Moonwitch.Reform.Button" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/mw_add_games"/>
</LinearLayout>
<com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:visibility="gone"/>
</FrameLayout><com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/library_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:background="@color/mw_reform_bg" app:menu="@menu/mw_reform_navigation" app:labelVisibilityMode="labeled" app:itemIconTint="@color/mw_reform_navigation" app:itemTextColor="@color/mw_reform_navigation" app:itemActiveIndicatorStyle="@null"/></LinearLayout>