<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/moonwitch_background"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/library_hero"
        android:layout_width="0dp"
        android:layout_height="310dp"
        android:clipChildren="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/library_hero_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.30"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/default_icon" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mw_home_frontend_hero_scrim" />

        <ImageView
            android:id="@+id/ambient_logo"
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="-48dp"
            android:alpha="0.055"
            android:contentDescription="@null"
            android:src="@drawable/moonwitch_app_icon" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/brand_mark"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/moonwitch_app_icon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/brand_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/filter_button"
                    app:layout_constraintStart_toEndOf="@id/brand_mark"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="@string/app_name"
                        android:textAllCaps="true"
                        android:textColor="@color/mw_ui_text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mw_ui_library"
                        android:textColor="@color/mw_ui_text_2"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/view_button"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/filter_button"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/filter_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="7dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mw_ui_surface_2"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/settings_button"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/mw_ui_border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/mw_ui_all"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/mw_ui_accent_hi" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/settings_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/mw_ui_surface_2"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/mw_ui_border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/mw_ui_settings"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/mw_ui_accent_hi" />
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.18"
                android:text="@string/mw_ui_library"
                android:textAllCaps="true"
                android:textColor="@color/mw_ui_accent_hi"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/library_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/mw_ui_text"
                android:textSize="24sp"
                tools:text="The Legend of Zelda: Tears of the Kingdom" />

            <TextView
                android:id="@+id/library_hero_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/mw_ui_text_2"
                android:textSize="11sp"
                tools:text="Nintendo • 1.4.3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/library_hero_play"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/mw_ui_play"
                    android:textColor="@color/mw_ui_text"
                    android:textSize="11sp"
                    app:backgroundTint="@color/mw_ui_accent"
                    app:cornerRadius="15dp"
                    app:icon="@drawable/ic_play"
                    app:iconSize="16dp"
                    app:iconTint="@color/mw_ui_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/library_hero_open"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="@string/mw_home_frontend_open_hub"
                    android:textColor="@color/mw_ui_text"
                    android:textSize="11sp"
                    app:backgroundTint="@color/mw_ui_surface_2"
                    app:cornerRadius="15dp"
                    app:icon="@drawable/ic_info_outline"
                    app:iconSize="16dp"
                    app:iconTint="@color/mw_ui_accent_hi"
                    app:strokeColor="@color/mw_ui_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frame_search"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_hero">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/mw_ui_accent_hi" />

                <EditText
                    android:id="@+id/search_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/home_search_games"
                    android:imeOptions="flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/mw_ui_text"
                    android:textColorHint="@color/mw_ui_text_3"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/clear_button"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_clear"
                android:visibility="invisible"
                app:tint="@color/mw_ui_text_2" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/library_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:text="@string/moonwitch_select_game"
        android:textAllCaps="true"
        android:textColor="@color/mw_ui_text_2"
        android:textSize="9sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/frame_search" />

    <View
        android:layout_width="58dp"
        android:layout_height="2dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/moonwitch_accent_line"
        app:layout_constraintBottom_toBottomOf="@id/library_section_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/library_section_label" />

    <org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_section_label">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/empty_gamelist"
                android:textColor="@color/mw_ui_text_2"
                android:textSize="14sp"
                android:visibility="gone" />

            <org.yuzu.yuzu_emu.ui.CarouselRecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="74dp"
                android:scrollbars="none" />
        </RelativeLayout>
    </org.yuzu.yuzu_emu.ui.MidScreenSwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/launch_qlaunch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/moonwitch_system_menu"
        android:text="@string/moonwitch_system_menu"
        android:textColor="@color/mw_ui_text"
        app:backgroundTint="@color/mw_ui_surface_2"
        app:icon="@drawable/moonwitch_app_icon"
        app:iconTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/mw_ui_border"
        app:strokeWidth="1dp" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_directory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/moonwitch_manage_library"
        android:text="@string/moonwitch_manage_library"
        android:textColor="@color/mw_ui_text"
        app:backgroundTint="@color/mw_ui_accent"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/mw_ui_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
