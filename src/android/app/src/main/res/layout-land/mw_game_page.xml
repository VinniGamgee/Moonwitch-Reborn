<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/mwBackground">
<ImageView android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
<View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/mw_reform_scrim"/>
<androidx.core.widget.NestedScrollView android:layout_width="420dp" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:fillViewport="false" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
<FrameLayout android:id="@+id/game_icon_frame" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginBottom="8dp" android:padding="3dp" android:background="@drawable/mw_game_icon_frame" android:elevation="4dp" android:importantForAccessibility="no">
<ImageView android:id="@+id/game_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/mw_game_icon_surface" android:clipToOutline="true" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/game_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="22sp" android:textStyle="bold" android:textColor="?attr/mwText"/>
<TextView android:id="@+id/game_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="?attr/mwMuted"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/play" style="@style/Widget.Moonwitch.Reform.Button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/mw_ui_play" app:icon="@drawable/ic_play" app:iconGravity="textStart"/><com.google.android.material.button.MaterialButton android:id="@+id/details" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="8dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/mw_reform_details" android:textColor="?attr/mwText" app:cornerRadius="24dp"/><androidx.appcompat.widget.AppCompatImageButton android:id="@+id/favorite" style="@style/Widget.Moonwitch.Reform.Icon" android:src="@drawable/ic_mw_star" android:contentDescription="@string/mw_favorite_game_desc"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
<TextView android:id="@+id/page_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="?attr/mwText"/>
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/mw_reform_swipe" android:textSize="12sp" android:textColor="?attr/mwMuted"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/previous" style="@style/Widget.Moonwitch.Reform.Icon" android:src="@drawable/mw_reform_previous" android:contentDescription="@string/mw_reform_previous"/>
<androidx.appcompat.widget.AppCompatImageButton android:id="@+id/next" style="@style/Widget.Moonwitch.Reform.Icon" android:src="@drawable/mw_reform_next" android:contentDescription="@string/mw_reform_next"/>
</LinearLayout></LinearLayout></androidx.core.widget.NestedScrollView></FrameLayout>