</LinearLayout><EditText android:id="@+id/search_text" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="16dp" android:visibility="gone" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:hint="@string/mw_reform_search" android:textSize="16sp" android:textColor="?attr/mwText" android:textColorHint="?attr/mwMuted"/><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
