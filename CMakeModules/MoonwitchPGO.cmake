# Native Android PGO is opt-in. A normal build never silently uses a stale profile.
set(MOONWITCH_PGO_MODE "OFF" CACHE STRING "OFF, GENERATE or USE")
set_property(CACHE MOONWITCH_PGO_MODE PROPERTY STRINGS OFF GENERATE USE)
set(MOONWITCH_PGO_PROFILE "" CACHE FILEPATH "Merged profile from this NDK and source revision")
if(MOONWITCH_PGO_MODE STREQUAL "OFF")
    return()
endif()
if(NOT ANDROID OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "Moonwitch PGO requires Android NDK Clang")
endif()
if(MOONWITCH_PGO_MODE STREQUAL "GENERATE")
    set(pgo_flag "-fprofile-generate")
    target_compile_definitions(yuzu-android PRIVATE MOONWITCH_PGO_GENERATE=1)
elseif(MOONWITCH_PGO_MODE STREQUAL "USE")
    if(NOT EXISTS "${MOONWITCH_PGO_PROFILE}" OR IS_DIRECTORY "${MOONWITCH_PGO_PROFILE}")
        message(FATAL_ERROR "PGO USE requires an existing merged .profdata file")
    endif()
    set(pgo_flag "-fprofile-use=${MOONWITCH_PGO_PROFILE}")
else()
    message(FATAL_ERROR "Invalid MOONWITCH_PGO_MODE: ${MOONWITCH_PGO_MODE}")
endif()
# Instrument the native emulator, not independent shared libraries or host tools.
foreach(pgo_target common core audio_core video_core shader_recompiler input_common frontend_common yuzu-android)
    if(NOT TARGET ${pgo_target})
        message(FATAL_ERROR "Missing PGO target ${pgo_target}")
    endif()
    target_compile_options(${pgo_target} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:${pgo_flag}>")
    if(MOONWITCH_PGO_MODE STREQUAL "GENERATE")
        target_compile_options(${pgo_target} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:-fprofile-update=atomic>")
    endif()
endforeach()
target_link_options(yuzu-android PRIVATE "${pgo_flag}")
message(STATUS "Moonwitch native PGO: ${MOONWITCH_PGO_MODE}")
